# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# For local development with Docker: postgresql://suwayq_user:123456@localhost:5432/suwayq_db
DATABASE_URL="postgresql://suwayq_user:123456@localhost:5432/suwayq_db"

# ============================================
# NextAuth Configuration
# ============================================
# A random string used to hash tokens, sign cookies and generate cryptographic keys.
# Generate a random string: openssl rand -base64 32
# IMPORTANT: Change this in production!
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-12345"

# The URL where NextAuth.js is deployed
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# API Configuration
# ============================================
# Public API URL (accessible from the browser)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ============================================
# Cloudinary Configuration (Optional)
# ============================================
# Uncomment and fill these if you want to use Cloudinary for image uploads
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# ============================================
# Environment
# ============================================
NODE_ENV="development"
